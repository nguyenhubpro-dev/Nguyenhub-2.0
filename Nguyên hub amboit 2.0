-- ==========================================
-- 4. BỘ LỌC NPC BIẾT DI CHUYỂN & RAYCAST TẦM MẮT
-- ==========================================
local sharedRayParams = RaycastParams.new()
sharedRayParams.FilterType = Enum.RaycastFilterType.Exclude
sharedRayParams.IgnoreWater = true

local function isEnemyPlayer(plr)
    if not plr or plr == LocalPlayer then return false end
    if not teamCheckEnabled then return true end
    if LocalPlayer.Team ~= nil and plr.Team ~= nil then
        return plr.Team ~= LocalPlayer.Team
    end
    return true
end

local function isSelfInLobbyMenu()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar.Parent then return true end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then return true end
    return false
end

local function getMyEyePosition()
    local myChar = LocalPlayer.Character
    if myChar then
        local myHead = myChar:FindFirstChild("Head")
        if myHead and myHead:IsA("BasePart") then
            return myHead.Position
        end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if myRoot and myRoot:IsA("BasePart") then
            return myRoot.Position + Vector3.new(0, 1.5, 0)
        end
    end
    local cam = workspace.CurrentCamera
    return cam and cam.CFrame.Position or Vector3.zero
end

local function hasClearLineOfSight(targetPart, targetModel)
    local origin = getMyEyePosition()
    local direction = targetPart.Position - origin
    if direction.Magnitude < 1.0 then return true end

    local cam = workspace.CurrentCamera
    local ignoreList = {}
    if cam then table.insert(ignoreList, cam) end
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end
    sharedRayParams.FilterDescendantsInstances = ignoreList

    local result = workspace:Raycast(origin, direction, sharedRayParams)
    if not result then
        return true
    end
    local hit = result.Instance
    if not hit then return true end
    if hit:IsDescendantOf(targetModel) then
        return true
    end
    if hit.Transparency >= 0.9 or not hit.CanCollide then
        return true
    end
    return false
end

-- Kiểm tra model có phải là NPC biết di chuyển (không phải người chơi, không phải tượng đứng yên)
local function checkIfMovingNpc(model)
    if not model or not model:IsA("Model") or not model.Parent then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not hum or not root or not root:IsA("BasePart") then return false end
    if hum.Health <= 0 or hum.WalkSpeed <= 0 then return false end

    local rec = npcCache[model]
    local now = os.clock()
    if not rec then
        rec = {
            model = model,
            hum = hum,
            root = root,
            lastPos = root.Position,
            lastMoveTime = 0,
            isMovingNpc = false,
        }
        npcCache[model] = rec
    end

    -- Kiểm tra di chuyển thực tế (MoveDirection, vận tốc hoặc thay đổi tọa độ > 0.35 studs)
    local movedDist = (root.Position - rec.lastPos).Magnitude
    local velMag = root.AssemblyLinearVelocity.Magnitude
    if hum.MoveDirection.Magnitude > 0.05 or velMag > 0.6 or movedDist > 0.35 then
        rec.isMovingNpc = true
        rec.lastMoveTime = now
        rec.lastPos = root.Position
    elseif (now - rec.lastMoveTime) > 12 then
        -- Nếu đứng bất động hoàn toàn hơn 12s thì coi như NPC trang trí/cửa hàng
        rec.isMovingNpc = false
    end

    return rec.isMovingNpc
end

-- ==========================================
-- 5. ESP PHÂN BIỆT NGƯỜI CHƠI (ƯU TIÊN) & NPC (PHỤ)
-- ==========================================
local function destroyEspForKey(key)
    local data = espCache[key]
    if data then
        if data.highlight and data.highlight.Parent then
            data.highlight:Destroy()
        end
        if data.billboard and data.billboard.Parent then
            data.billboard:Destroy()
        end
        espCache[key] = nil
    end
end

local function clearAllEsp()
    for key, _ in pairs(espCache) do
        destroyEspForKey(key)
    end
end

local function attachInstantEsp(key, model, displayName, isNpc)
    destroyEspForKey(key)
    if not espEnabled or not model or not model.Parent then return end
    if isNpc and not npcEnabled then return end
    if not isNpc and not isEnemyPlayer(key) then return end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return end

    local hl = Instance.new("Highlight")
    hl.Name = isNpc and "NguyenHub_ESP_NPC" or "NguyenHub_ESP_PLR"
    hl.FillTransparency = isNpc and 0.78 or 0.62
    hl.OutlineTransparency = isNpc and 0.25 or 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = isNpc and COLOR_NPC or COLOR_WARN
    hl.OutlineColor = isNpc and COLOR_NPC or COLOR_ON
    hl.Adornee = model
    hl.Parent = ScreenGui

    local attachPart = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    local bb, distLbl
    if attachPart and attachPart.Parent then
        bb = Instance.new("BillboardGui")
        bb.Name = "NguyenHub_ESP_Tag"
        bb.Adornee = attachPart
        bb.Size = UDim2.fromOffset(155, 24)
        bb.StudsOffset = Vector3.new(0, 2.7, 0)
        bb.AlwaysOnTop = true
        bb.MaxDistance = math.huge
        bb.Parent = ScreenGui

        distLbl = Instance.new("TextLabel")
        distLbl.Size = UDim2.new(1, 0, 1, 0)
        distLbl.BackgroundTransparency = 1
        distLbl.Text = isNpc and ("[NPC] " .. displayName) or displayName
        distLbl.TextColor3 = isNpc and COLOR_NPC or COLOR_TEXT_MAIN
        distLbl.TextStrokeTransparency = 0.25
        distLbl.Font = isNpc and Enum.Font.GothamSemibold or Enum.Font.GothamBold
        distLbl.TextSize = isNpc and 10 or 11
        distLbl.Parent = bb
    end

    espCache[key] = {
        highlight = hl,
        billboard = bb,
        label = distLbl,
        char = model,
        displayName = displayName,
        isNpc = isNpc,
        isVisible = false,
    }

    if hum then
        hum.Died:Connect(function()
            destroyEspForKey(key)
            if isNpc then npcCache[model] = nil end
        end)
    end
end

local function bindPlayerEvents(plr)
    if plr == LocalPlayer then return end

    if plr.Character then
        task.spawn(attachInstantEsp, plr, plr.Character, plr.DisplayName, false)
    end

    local c1 = plr.CharacterAdded:Connect(function(newChar)
        attachInstantEsp(plr, newChar, plr.DisplayName, false)
    end)

    local c2 = plr.CharacterRemoving:Connect(function()
        destroyEspForKey(plr)
    end)

    local c3 = plr:GetPropertyChangedSignal("Team"):Connect(function()
        if plr.Character and isEnemyPlayer(plr) then
            attachInstantEsp(plr, plr.Character, plr.DisplayName, false)
        else
            destroyEspForKey(plr)
        end
    end)

    table.insert(globalConns, c1)
    table.insert(globalConns, c2)
    table.insert(globalConns, c3)
end

-- Quét tìm NPC biết di chuyển trong Workspace (không quét sâu quá nhiều cấp để nhẹ FPS)
local function scanWorkspaceMovingNpcs()
    if not npcEnabled then
        table.clear(npcCache)
        return
    end

    local seen = {}
    local function inspectContainer(container, depth)
        if depth > 3 then return end
        local children = container:GetChildren()
        for i = 1, #children do
            local obj = children[i]
            if obj:IsA("Model") then
                if obj:FindFirstChildOfClass("Humanoid") then
                    seen[obj] = true
                    if checkIfMovingNpc(obj) and espEnabled and not espCache[obj] then
                        attachInstantEsp(obj, obj, obj.Name, true)
                    end
                else
                    inspectContainer(obj, depth + 1)
                end
            elseif obj:IsA("Folder") then
                inspectContainer(obj, depth + 1)
            end
        end
    end

    inspectContainer(workspace, 1)

    for model, _ in pairs(npcCache) do
        if not seen[model] or not model.Parent then
            npcCache[model] = nil
            destroyEspForKey(model)
        end
    end
end

local function rebuildAllEsp()
    clearAllEsp()
    if not espEnabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            task.spawn(attachInstantEsp, plr, plr.Character, plr.DisplayName, false)
        end
    end
    if npcEnabled then
        scanWorkspaceMovingNpcs()
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
    bindPlayerEvents(plr)
end

table.insert(globalConns, Players.PlayerAdded:Connect(bindPlayerEvents))
table.insert(globalConns, Players.PlayerRemoving:Connect(function(plr)
    destroyEspForKey(plr)
end))

-- ==========================================
-- 6. BỘ CHỌN MỤC TIÊU: ƯU TIÊN NGƯỜI CHƠI TRƯỚC -> NPC DI CHUYỂN SAU
-- ==========================================
-- Trả về: targetPart, targetKey, targetName, dist3D, isBehind, isClear, isBackstab, isNpcTarget
local function getPriorityTarget()
    if isSelfInLobbyMenu() then
        return nil, nil, "", 0, false, false, false, false
    end

    local cam = workspace.CurrentCamera
    if not cam then return nil, nil, "", 0, false, false, false, false end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    local refPos = myRoot and myRoot.Position or cam.CFrame.Position
    local camLook = cam.CFrame.LookVector

    local vp = cam.ViewportSize
    local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)

    -- 1. Các biến lưu mục tiêu NGƯỜI CHƠI (Ưu tiên số 1)
    local pRearDist = backstabAlertRange
    local pRearPart, pRearPlr = nil, nil

    local pVisMetric = scan360Enabled and maxRange360 or fovRadius
    local pVisPart, pVisPlr, pVisDist, pVisBehind = nil, nil, 0, false

    local pWallMetric = scan360Enabled and maxRange360 or fovRadius
    local pWallPart, pWallPlr, pWallDist, pWallBehind = nil, nil, 0, false

    local playerList = Players:GetPlayers()
    for i = 1, #playerList do
        local plr = playerList[i]
        if isEnemyPlayer(plr) then
            local char = plr.Character
            if char and char.Parent then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    if not (ignoreSpawnShield and char:FindFirstChildOfClass("ForceField")) then
                        local offsetVec = root.Position - refPos
                        local dist3D = offsetVec.Magnitude
                        local aimPart = (dist3D < 12 or targetPartMode == "HumanoidRootPart") and root or (char:FindFirstChild("Head") or root)

                        if aimPart and aimPart:IsA("BasePart") then
                            local dirUnit = (dist3D > 0.01) and (offsetVec / dist3D) or camLook
                            local dotAngle = camLook:Dot(dirUnit)
                            local isFlankingOrBehind = (dotAngle < 0.35)
                            local isStrictlyBehind = (dotAngle < 0)

                            local clearSight = hasClearLineOfSight(aimPart, char)
                            if espCache[plr] then
                                espCache[plr].isVisible = clearSight
                            end

                            if antiBackstabEnabled and clearSight and isFlankingOrBehind and dist3D < pRearDist then
                                pRearDist = dist3D
                                pRearPart = aimPart
                                pRearPlr = plr
                            end

                            local inRange, metric = false, math.huge
                            if scan360Enabled then
                                if dist3D < maxRange360 then
                                    inRange = true
                                    metric = dist3D
                                end
                            else
                                local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
                                if onScreen and screenPos.Z > 0 then
                                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                                    if screenDist < fovRadius then
                                        inRange = true
                                        metric = screenDist
                                    end
                                end
                            end

                            if inRange then
                                if clearSight then
                                    if metric < pVisMetric then
                                        pVisMetric = metric
                                        pVisPart = aimPart
                                        pVisPlr = plr
                                        pVisDist = dist3D
                                        pVisBehind = isStrictlyBehind
                                    end
                                elseif not smartWallPriority then
                                    if metric < pWallMetric then
                                        pWallMetric = metric
                                        pWallPart = aimPart
                                        pWallPlr = plr
                                        pWallDist = dist3D
                                        pWallBehind = isStrictlyBehind
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Nếu tìm thấy bất kỳ NGƯỜI CHƠI hợp lệ nào -> Khóa ngay người chơi (không để NPC tranh mất tâm)
    if pRearPart then
        return pRearPart, pRearPlr, pRearPlr.DisplayName, pRearDist, true, true, true, false
    elseif pVisPart then
        return pVisPart, pVisPlr, pVisPlr.DisplayName, pVisDist, pVisBehind, true, false, false
    elseif pWallPart then
        return pWallPart, pWallPlr, pWallPlr.DisplayName, pWallDist, pWallBehind, false, false, false
    end

    -- 2. Nếu không có người chơi nào trong tầm và bật NPC -> Xét tới NPC biết di chuyển
    if npcEnabled then
        local nRearDist = backstabAlertRange
        local nRearPart, nRearModel = nil, nil

        local nVisMetric = scan360Enabled and maxRange360 or fovRadius
        local nVisPart, nVisModel, nVisDist, nVisBehind = nil, nil, 0, false

        for model, rec in pairs(npcCache) do
            if model and model.Parent and rec.isMovingNpc and rec.hum and rec.hum.Health > 0 and rec.root and rec.root.Parent then
                local offsetVec = rec.root.Position - refPos
                local dist3D = offsetVec.Magnitude
                local aimPart = (dist3D < 12 or targetPartMode == "HumanoidRootPart") and rec.root or (model:FindFirstChild("Head") or rec.root)

                if aimPart and aimPart:IsA("BasePart") then
                    local dirUnit = (dist3D > 0.01) and (offsetVec / dist3D) or camLook
                    local dotAngle = camLook:Dot(dirUnit)
                    local isFlankingOrBehind = (dotAngle < 0.35)
                    local isStrictlyBehind = (dotAngle < 0)

                    local clearSight = hasClearLineOfSight(aimPart, model)
                    if espCache[model] then
                        espCache[model].isVisible = clearSight
                    end

                    if clearSight then
                        if antiBackstabEnabled and isFlankingOrBehind and dist3D < nRearDist then
                            nRearDist = dist3D
                            nRearPart = aimPart
                            nRearModel = model
                        end

                        local inRange, metric = false, math.huge
                        if scan360Enabled then
                            if dist3D < maxRange360 then
                                inRange = true
                                metric = dist3D
                            end
                        else
                            local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
                            if onScreen and screenPos.Z > 0 then
                                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                                if screenDist < fovRadius then
                                    inRange = true
                                    metric = screenDist
                                end
                            end
                        end

                        if inRange and metric < nVisMetric then
                            nVisMetric = metric
                            nVisPart = aimPart
                            nVisModel = model
                            nVisDist = dist3D
                            nVisBehind = isStrictlyBehind
                        end
                    end
                end
            end
        end

        if nRearPart then
            return nRearPart, nRearModel, nRearModel.Name, nRearDist, true, true, true, true
        elseif nVisPart then
            return nVisPart, nVisModel, nVisModel.Name, nVisDist, nVisBehind, true, false, true
        end
    end

    return nil, nil, "", 0, false, false, false, false
end

-- ==========================================
-- 7. CẬP NHẬT GIAO DIỆN & ĐÓNG MỞ MENU CHỐNG CHẠM NHẦM
-- ==========================================
local function updateCardVisual(isOn, dot, label, stroke, textOn, textOff)
    if isOn then
        dot.BackgroundColor3 = COLOR_ON
        label.Text = textOn
        label.TextColor3 = COLOR_ON
        stroke.Color = COLOR_ON
        stroke.Transparency = 0.45
    else
        dot.BackgroundColor3 = COLOR_OFF
        label.Text = textOff
        label.TextColor3 = COLOR_TEXT_MAIN
        stroke.Color = COLOR_BORDER
        stroke.Transparency = 0
    end
end

local function countVisibleTargets()
    local plrCount, npcCount = 0, 0
    for key, data in pairs(espCache) do
        if data.char and data.char.Parent then
            if data.isNpc then
                if npcEnabled then npcCount += 1 end
            elseif isEnemyPlayer(key) and data.isVisible then
                plrCount += 1
            end
        end
    end
    return plrCount, npcCount
end

local function updateRangeAndFooterUI()
    FovFrame.Size = UDim2.fromOffset(fovRadius * 2, fovRadius * 2)
    local plrCount, npcCount = countVisibleTargets()

    if antiBackstabEnabled then
        RangeLabel.Text = "Tầm Chặn Sau Lưng: " .. tostring(backstabAlertRange) .. "m"
    elseif scan360Enabled then
        RangeLabel.Text = "Tầm Quét 360°: " .. tostring(maxRange360) .. "m"
    else
        RangeLabel.Text = "Bán Kính Vòng FOV: " .. tostring(fovRadius)
    end
    StatsFooter.Text = string.format("Người: %d | NPC: %d", plrCount, npcCount)
    GunVer.Text = "1.5"
end

local function setScan360Mode(state)
    scan360Enabled = state
    if scan360Enabled then
        ScanModeDot.BackgroundColor3 = COLOR_360
        ScanModeLabel.Text = "Quét Mục Tiêu: 360° Gần Nhất (Trước & Sau)"
        ScanModeLabel.TextColor3 = COLOR_360
        ScanModeStroke.Color = COLOR_360
        ScanModeStroke.Transparency = 0.4
    else
        ScanModeDot.BackgroundColor3 = COLOR_ON
        ScanModeLabel.Text = "Quét Mục Tiêu: Vòng FOV + Chặn Sau Lưng"
        ScanModeLabel.TextColor3 = COLOR_ON
        ScanModeStroke.Color = COLOR_ON
        ScanModeStroke.Transparency = 0.45
    end
    updateRangeAndFooterUI()
end

local function setAntiBackstab(state)
    antiBackstabEnabled = state
    if antiBackstabEnabled then
        BackstabDot.BackgroundColor3 = COLOR_LOCK
        BackstabLabel.Text = string.format("Chống Bắn Lén: Giật 180° Chặn Sau (<%dm)", backstabAlertRange)
        BackstabLabel.TextColor3 = COLOR_LOCK
        BackstabStroke.Color = COLOR_LOCK
        BackstabStroke.Transparency = 0.4
    else
        BackstabDot.BackgroundColor3 = COLOR_OFF
        BackstabLabel.Text = "Chống Bắn Lén: Tắt"
        BackstabLabel.TextColor3 = COLOR_TEXT_MAIN
        BackstabStroke.Color = COLOR_BORDER
        BackstabStroke.Transparency = 0
    end
    updateRangeAndFooterUI()
end

local smoothPresets = {
    { val = 0.35, text = "Độ Mượt Tâm: Mượt (35%)" },
    { val = 0.60, text = "Độ Mượt Tâm: Nhanh (60%)" },
    { val = 0.80, text = "Độ Mượt Tâm: Bám Gắt (80%)" },
    { val = 1.00, text = "Độ Mượt Tâm: Khóa Cứng 0ms (100%)" },
}
local currentSmoothIdx = 3

local function updateSmoothUI()
    local p = smoothPresets[currentSmoothIdx]
    smoothness = p.val
    SmoothLabel.Text = p.text
    if smoothness >= 0.80 then
        SmoothLabel.TextColor3 = COLOR_LOCK
        SmoothStroke.Color = COLOR_LOCK
        SmoothStroke.Transparency = 0.35
    else
        SmoothLabel.TextColor3 = COLOR_WARN
        SmoothStroke.Color = COLOR_WARN
        SmoothStroke.Transparency = 0.55
    end
end

-- Viền chuyển sắc 7 màu dịu nhẹ
task.spawn(function()
    local hue = 0
    while ScreenGui and ScreenGui.Parent do
        hue = (hue + 0.008) % 1
        local softColor = Color3.fromHSV(hue, 0.44, 0.78)
        UIStroke.Color = softColor
        Title.TextColor3 = softColor
        GunStroke.Color = softColor
        GunVer.TextColor3 = softColor
        if not lockedTarget then
            FovStroke.Color = softColor
        end
        task.wait(0.22)
    end
end)

local function collapseToGun()
    if isMenuMinimized then return end
    isMenuMinimized = true
    local t = TweenService:Create(
        MainFrame,
        TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = GUN_ICON_SIZE }
    )
    t:Play()
    t.Completed:Connect(function()
        MainFrame.Visible = false
        MainFrame.Size = EXPANDED_SIZE
        GunToggleBtn.Visible = true
    end)
end

local function expandFromGun()
    isMenuMinimized = false
    GunToggleBtn.Visible = false
    MainFrame.Visible = true
    MainFrame.Size = GUN_ICON_SIZE
    TweenService:Create(
        MainFrame,
        TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = EXPANDED_SIZE }
    ):Play()
end

local lastGunTapTime = 0
local function handleGunIconTap()
    if not doubleTapOpenEnabled then
        expandFromGun()
        return
    end

    local now = os.clock()
    if (now - lastGunTapTime) <= 0.38 then
        lastGunTapTime = 0
        expandFromGun()
    else
        lastGunTapTime = now
        GunToggleBtn.BackgroundTransparency = 0.02
        GunStroke.Thickness = 2.2
        task.delay(0.38, function()
            if GunToggleBtn and GunToggleBtn.Parent then
                GunToggleBtn.BackgroundTransparency = 0.12
                GunStroke.Thickness = 1.3
            end
        end)
    end
end

MinimizeBtn.MouseButton1Click:Connect(collapseToGun)
makeDraggable(GunToggleBtn, GunToggleBtn, handleGunIconTap, nil)

-- ==========================================
-- 8. KÍCH HOẠT AIMBOT & ESP (ƯU TIÊN NGƯỜI CHƠI -> NPC)
-- ==========================================
local function setAimbot(state)
    aimbotEnabled = state
    updateCardVisual(
        aimbotEnabled,
        AimDot,
        AimLabel,
        AimStroke,
        "Aimbot Ưu Tiên Người Chơi + NPC: Bật",
        "Aimbot Ưu Tiên Người Chơi + NPC: Tắt"
    )
    GunStatusDot.BackgroundColor3 = aimbotEnabled and COLOR_ON or COLOR_OFF
    CenterDot.BackgroundColor3 = aimbotEnabled and COLOR_ON or COLOR_OFF

    if aimConn then
        aimConn:Disconnect()
        aimConn = nil
    end

    if aimbotEnabled then
        task.delay(0.15, function()
            if aimbotEnabled and not isMenuMinimized then
                collapseToGun()
            end
        end)

        aimConn = RunService.RenderStepped:Connect(function(dt)
            if not aimbotEnabled or not ScreenGui or not ScreenGui.Parent then return end
            local cam = workspace.CurrentCamera
            if not cam then return end

            local targetPart, targetKey, targetName, dist3D, isBehind, isClear, isBackstab, isNpc = getPriorityTarget()
            lockedTarget = targetKey

            if targetPart and targetKey then
                FovStroke.Color = isNpc and COLOR_NPC or COLOR_LOCK
                CenterDot.BackgroundColor3 = isNpc and COLOR_NPC or COLOR_LOCK

                local prefix = isNpc and "[NPC] " or ""
                if isBackstab then
                    TargetStatusText.Text = string.format("🚨 Sau lưng: %s%s (%.0fm)", prefix, targetName, dist3D)
                    TargetStatusText.TextColor3 = isNpc and COLOR_NPC or COLOR_LOCK
                elseif dist3D < 12 then
                    TargetStatusText.Text = string.format("🔥 Sát mặt: %s%s (%.1fm)", prefix, targetName, dist3D)
                    TargetStatusText.TextColor3 = isNpc and COLOR_NPC or COLOR_LOCK
                elseif isNpc then
                    TargetStatusText.Text = string.format("🤖 Khóa NPC: %s (%.0fm)", targetName, dist3D)
                    TargetStatusText.TextColor3 = COLOR_NPC
                elseif isClear then
                    TargetStatusText.Text = string.format("🎯 Người chơi: %s (%.0fm)", targetName, dist3D)
                    TargetStatusText.TextColor3 = COLOR_ON
                else
                    TargetStatusText.Text = string.format("🧱 Sau tường: %s (%.0fm)", targetName, dist3D)
                    TargetStatusText.TextColor3 = COLOR_WARN
                end

                local camPos = cam.CFrame.Position
                local targetPos = targetPart.Position
                if (targetPos - camPos).Magnitude > 0.2 then
                    local targetCFrame = CFrame.lookAt(camPos, targetPos)
                    if smoothness >= 1 or isBackstab or dist3D < 15 then
                        cam.CFrame = targetCFrame
                    else
                        local alpha = math.clamp(smoothness * (dt * 60), 0.15, 1)
                        cam.CFrame = cam.CFrame:Lerp(targetCFrame, alpha)
                    end
                end
            else
                CenterDot.BackgroundColor3 = COLOR_ON
                TargetStatusText.Text = "Đang quét Người chơi & NPC..."
                TargetStatusText.TextColor3 = COLOR_TEXT_DIM
            end
        end)
    else
        lockedTarget = nil
        TargetStatusText.Text = "Chờ bật Aimbot..."
        TargetStatusText.TextColor3 = COLOR_TEXT_DIM
    end
end

local function setEsp(state)
    espEnabled = state
    updateCardVisual(espEnabled, EspDot, EspLabel, EspStroke, "ESP Người + NPC: Bật", "ESP Người + NPC: Tắt")

    if espConn then
        espConn:Disconnect()
        espConn = nil
    end

    if espEnabled then
        rebuildAllEsp()

        local acc = 0
        local npcScanAcc = 0
        espConn = RunService.Heartbeat:Connect(function(dt)
            acc += dt
            npcScanAcc += dt

            -- Quét tìm NPC di chuyển mới sinh ra mỗi 0.6s
            if npcEnabled and npcScanAcc >= 0.6 then
                npcScanAcc = 0
                scanWorkspaceMovingNpcs()
            end

            if acc < 0.15 then return end
            acc = 0

            local cam = workspace.CurrentCamera
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local refPos = (myRoot and myRoot.Position) or (cam and cam.CFrame.Position)

            for _, plr in ipairs(Players:GetPlayers()) do
                if isEnemyPlayer(plr) and plr.Character and not espCache[plr] then
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        attachInstantEsp(plr, plr.Character, plr.DisplayName, false)
                    end
                end
            end

            for key, data in pairs(espCache) do
                if data.char and data.char.Parent then
                    if data.isNpc and not npcEnabled then
                        destroyEspForKey(key)
                    elseif not data.isNpc and not isEnemyPlayer(key) then
                        destroyEspForKey(key)
                    else
                        local root = data.char:FindFirstChild("HumanoidRootPart") or data.char.PrimaryPart
                        local head = data.char:FindFirstChild("Head") or root
                        if head and head:IsA("BasePart") then
                            data.isVisible = hasClearLineOfSight(head, data.char)
                        end

                        local isLocked = (lockedTarget == key)
                        if data.highlight then
                            if isLocked then
                                data.highlight.FillColor = COLOR_LOCK
                                data.highlight.OutlineColor = COLOR_LOCK
                                data.highlight.FillTransparency = 0.5
                            elseif data.isNpc then
                                -- ESP NPC màu xanh dịu & mờ hơn người chơi để không tranh điểm nhấn
                                data.highlight.FillColor = COLOR_NPC
                                data.highlight.OutlineColor = COLOR_NPC
                                data.highlight.FillTransparency = data.isVisible and 0.74 or 0.86
                            elseif data.isVisible then
                                data.highlight.FillColor = COLOR_WARN
                                data.highlight.OutlineColor = COLOR_ON
                                data.highlight.FillTransparency = 0.60
                            else
                                data.highlight.FillColor = COLOR_HIDDEN
                                data.highlight.OutlineColor = COLOR_HIDDEN
                                data.highlight.FillTransparency = 0.82
                            end
                        end

                        if data.label and refPos and root then
                            local d = (root.Position - refPos).Magnitude
                            if data.isNpc then
                                data.label.Text = string.format("[NPC] %s [%.0fm]", data.displayName, d)
                                data.label.TextColor3 = isLocked and COLOR_LOCK or COLOR_NPC
                            elseif data.isVisible then
                                data.label.Text = string.format("● %s [%.0fm]", data.displayName, d)
                                data.label.TextColor3 = isLocked and COLOR_LOCK or COLOR_ON
                            else
                                data.label.Text = string.format("%s [%.0fm]", data.displayName, d)
                                data.label.TextColor3 = COLOR_TEXT_DIM
                            end
                        end
                    end
                else
                    destroyEspForKey(key)
                end
            end

            updateRangeAndFooterUI()
        end)
    else
        clearAllEsp()
    end
end

local function clampGuiInsideScreen(guiObj, vp)
    if not guiObj or not guiObj.Parent then return end
    local absPos = guiObj.AbsolutePosition
    local absSize = guiObj.AbsoluteSize
    local sgPos = ScreenGui.AbsolutePosition

    local minX, minY = 6, 6
    local maxX = math.max(minX, vp.X - absSize.X - 6)
    local maxY = math.max(minY, vp.Y - absSize.Y - 6)

    if absPos.X < minX or absPos.X > maxX or absPos.Y < minY or absPos.Y > maxY then
        local newX = math.clamp(absPos.X, minX, maxX) - sgPos.X
        local newY = math.clamp(absPos.Y, minY, maxY) - sgPos.Y
        guiObj.Position = UDim2.fromOffset(newX, newY)
    end
end

local fixFeedbackId = 0
local function quickFixScreen()
    table.clear(npcCache)
    rebuildAllEsp()
    GunToggleBtn.Position = SAFE_GUN_POS

    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            cam.FieldOfView = 70
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                cam.CameraSubject = hum
            end
            local vp = cam.ViewportSize
            clampGuiInsideScreen(MainFrame, vp)
            clampGuiInsideScreen(GunToggleBtn, vp)
        end
    end)

    pcall(function()
        for _, eff in ipairs(Lighting:GetChildren()) do
            if eff:IsA("BlurEffect") and eff.Enabled then
                eff.Enabled = false
            end
        end
        GuiService.SelectedObject = nil
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end)

    FovFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    updateRangeAndFooterUI()

    fixFeedbackId += 1
    local myId = fixFeedbackId
    FixScreenBtn.Text = "✓ Đã Fix Cam & Làm Mới Player / NPC!"
    FixScreenBtn.TextColor3 = COLOR_ON
    FixScreenStroke.Color = COLOR_ON

    task.delay(1.5, function()
        if myId == fixFeedbackId and FixScreenBtn and FixScreenBtn.Parent then
            FixScreenBtn.Text = "⚡ Fix Lỗi Màn Hình & Làm Mới Player / NPC"
            FixScreenBtn.TextColor3 = COLOR_FIX
            FixScreenStroke.Color = COLOR_FIX
        end
    end)
end

ScreenGui.Destroying:Connect(function()
    aimbotEnabled = false
    espEnabled = false
    if aimConn then aimConn:Disconnect() end
    if espConn then espConn:Disconnect() end
    for i = 1, #globalConns do
        if globalConns[i] then globalConns[i]:Disconnect() end
    end
    clearAllEsp()
end)

