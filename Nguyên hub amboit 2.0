end)

NpcBtn.MouseButton1Click:Connect(function()
    npcEnabled = not npcEnabled
    updateCardVisual(npcEnabled, NpcDot, NpcLabel, NpcStroke, "NPC Di Chuyển: Bật", "NPC Di Chuyển: Tắt")
    if not npcEnabled then
