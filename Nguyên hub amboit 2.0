local function createToggleCard(text, pos, size)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = COLOR_BG_CARD
    btn.Text = ""
    btn.AutoButtonColor = true
    btn.Parent = ContentFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = COLOR_BORDER
    stroke.Thickness = 1
    stroke.Parent = btn

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 6, 0, 6)
    dot.Position = UDim2.new(0, 9, 0.5, -3)
    dot.BackgroundColor3 = COLOR_OFF
    dot.BorderSizePixel = 0
    dot.Parent = btn
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -22, 1, 0)
    lbl.Position = UDim2.new(0, 20, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = COLOR_TEXT_MAIN
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 10
    lbl.Parent = btn

    return btn, dot, lbl, stroke
end

local function createStepperRow(posY, initialText, accentColor)
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 0, 27)
    box.Position = UDim2.new(0, 0, 0, posY)
    box.BackgroundColor3 = COLOR_BG_CARD
    box.Parent = ContentFrame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = accentColor or COLOR_BORDER
    stroke.Thickness = 1
    stroke.Transparency = accentColor and 0.55 or 0
    stroke.Parent = box

    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 34, 1, -4)
    minusBtn.Position = UDim2.new(0, 2, 0, 2)
    minusBtn.BackgroundColor3 = COLOR_BTN_SUB
    minusBtn.Text = "–"
    minusBtn.TextColor3 = COLOR_TEXT_MAIN
    minusBtn.Font = Enum.Font.GothamBold
    minusBtn.TextSize = 14
    minusBtn.Parent = box
    Instance.new("UICorner", minusBtn).CornerRadius = UDim.new(0, 6)

    local centerBtn = Instance.new("TextButton")
    centerBtn.Size = UDim2.new(1, -76, 1, 0)
    centerBtn.Position = UDim2.new(0, 38, 0, 0)
    centerBtn.BackgroundTransparency = 1
    centerBtn.Text = initialText
    centerBtn.TextColor3 = accentColor or COLOR_TEXT_MAIN
    centerBtn.Font = Enum.Font.GothamSemibold
    centerBtn.TextSize = 10
    centerBtn.Parent = box

    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 34, 1, -4)
    plusBtn.Position = UDim2.new(1, -36, 0, 2)
    plusBtn.BackgroundColor3 = COLOR_BTN_SUB
    plusBtn.Text = "+"
    plusBtn.TextColor3 = COLOR_TEXT_MAIN
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.TextSize = 14
    plusBtn.Parent = box
    Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 6)

    return minusBtn, centerBtn, plusBtn, stroke
end

