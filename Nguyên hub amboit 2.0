-- 9. GẮN SỰ KIỆN NÚT BẤM
-- ==========================================
AimbotBtn.MouseButton1Click:Connect(function()
    setAimbot(not aimbotEnabled)
end)

ScanModeBtn.MouseButton1Click:Connect(function()
    setScan360Mode(not scan360Enabled)
end)

BackstabBtn.MouseButton1Click:Connect(function()
    setAntiBackstab(not antiBackstabEnabled)
end)

RangeMinusBtn.MouseButton1Click:Connect(function()
    if antiBackstabEnabled then
        backstabAlertRange = math.clamp(backstabAlertRange - 15, 20, 300)
        setAntiBackstab(true)
    elseif scan360Enabled then
        maxRange360 = math.clamp(maxRange360 - 100, 100, 2500)
        updateRangeAndFooterUI()
    else
        fovRadius = math.clamp(fovRadius - 15, 30, 350)
        updateRangeAndFooterUI()
    end
end)

RangePlusBtn.MouseButton1Click:Connect(function()
    if antiBackstabEnabled then
        backstabAlertRange = math.clamp(backstabAlertRange + 15, 20, 300)
        setAntiBackstab(true)
    elseif scan360Enabled then
        maxRange360 = math.clamp(maxRange360 + 100, 100, 2500)
        updateRangeAndFooterUI()
    else
        fovRadius = math.clamp(fovRadius + 15, 30, 350)
        updateRangeAndFooterUI()
    end
end)

SmoothMinusBtn.MouseButton1Click:Connect(function()
    currentSmoothIdx = math.clamp(currentSmoothIdx - 1, 1, #smoothPresets)
    updateSmoothUI()
end)

SmoothPlusBtn.MouseButton1Click:Connect(function()
    currentSmoothIdx = math.clamp(currentSmoothIdx + 1, 1, #smoothPresets)
    updateSmoothUI()
end)

SmoothLabel.MouseButton1Click:Connect(function()
    currentSmoothIdx = (currentSmoothIdx % #smoothPresets) + 1
    updateSmoothUI()
end)

PartBtn.MouseButton1Click:Connect(function()
    if targetPartMode == "Head" then
        targetPartMode = "HumanoidRootPart"
        PartDot.BackgroundColor3 = COLOR_WARN
        PartLabel.Text = "Ngắm: Luôn Khóa Thân / Ngực (Body)"
        PartLabel.TextColor3 = COLOR_WARN
        PartStroke.Color = COLOR_WARN
        PartStroke.Transparency = 0.45
    else
        targetPartMode = "Head"
        PartDot.BackgroundColor3 = COLOR_ON
        PartLabel.Text = "Ngắm: Đầu (Tự Hạ Ngực Khi Áp Sát <12m)"
        PartLabel.TextColor3 = COLOR_ON
        PartStroke.Color = COLOR_ON
        PartStroke.Transparency = 0.45
    end
end)

EspBtn.MouseButton1Click:Connect(function()
